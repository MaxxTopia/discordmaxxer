+import { randomUUID } from 'node:crypto';
+import { workerData } from 'node:worker_threads';
+
+const workerPort = workerData?.workerPort;
+const pending = new Map();
+
+workerPort?.on('message', message => {
+  if (message?.type !== 'processes-response') return;
+  const resolve = pending.get(message.nonce);
+  if (!resolve) return;
+  pending.delete(message.nonce);
+  resolve(Array.isArray(message.data) ? message.data : []);
+});
+
+export const getProcesses = () => new Promise(resolve => {
+  if (!workerPort?.postMessage) {
+    resolve([]);
+    return;
+  }
+
+  const nonce = randomUUID();
+  const timeout = setTimeout(() => {
+    pending.delete(nonce);
+    resolve([]);
+  }, 2000);
+
+  pending.set(nonce, processes => {
+    clearTimeout(timeout);
+    resolve(processes);
+  });
+  workerPort.postMessage({ type: 'processes-request', nonce });
+});
