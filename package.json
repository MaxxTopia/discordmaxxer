{
    "name": "discordmaxxer",
    "version": "0.7.54",
    "private": true,
    "description": "Discord, optimized. 7th project in the maxxer suite. Forked from Vesktop.",
    "keywords": [
        "discord",
        "discordmaxxer",
        "vesktop",
        "vencord",
        "electron"
    ],
    "homepage": "https://github.com/MaxxTopia/discordmaxxer",
    "repository": {
        "type": "git",
        "url": "https://github.com/MaxxTopia/discordmaxxer.git"
    },
    "bugs": {
        "url": "https://github.com/MaxxTopia/discordmaxxer/issues"
    },
    "license": "GPL-3.0-or-later",
    "author": "Diggy",
    "contributors": [
        "Vendicated <vendicated@riseup.net> (original Vesktop author)"
    ],
    "main": "dist/js/main.js",
    "scripts": {
        "build": "tsx scripts/build/build.mts",
        "build:dev": "pnpm build --dev",
        "overlay:vencord": "node overlay-scripts/build-vencord.mjs",
        "overlay:full": "pnpm overlay:vencord && pnpm build:dev",
        "buildLibVesktop": "pnpm -C packages/libvesktop install && pnpm -C packages/libvesktop run build",
        "buildWinAudio": "pnpm -C packages/winaudio install && pnpm -C packages/winaudio run build",
        "package": "pnpm build && electron-builder",
        "package:dir": "pnpm build && electron-builder --dir",
        "package:win": "pnpm build && electron-builder --windows",
        "regen-icons": "node scripts/build/regenIcons.mjs",
        "lint": "eslint",
        "lint:fix": "pnpm lint --fix",
        "start": "pnpm build && electron .",
        "start:dev": "pnpm build:dev && electron .",
        "start:dev:debug": "pnpm build:dev && electron . --remote-debugging-port=9222",
        "start:watch": "pnpm build:dev && tsx scripts/startWatch.mts",
        "test": "pnpm lint && pnpm testTypes",
        "testTypes": "tsc --noEmit",
        "watch": "pnpm build --watch",
        "generateMeta": "tsx scripts/utils/generateMeta.mts",
        "updateArrpcDB": "node ./node_modules/arrpc/update_db.js",
        "postinstall": "pnpm updateArrpcDB"
    },
    "dependencies": {
        "@sapphi-red/web-noise-suppressor": "^0.3.5",
        "arrpc": "github:OpenAsar/arrpc#2234e9c9111f4c42ebcc3aa6a2215bfd979eef77",
        "electron-updater": "^6.6.2"
    },
    "optionalDependencies": {
        "@vencord/venmic": "^6.1.0"
    },
    "devDependencies": {
        "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^25.5.0",
        "@types/react": "19.2.9",
        "@vencord/types": "^1.14.1",
        "dotenv": "^17.3.1",
        "electron": "^43.0.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.27.4",
        "eslint": "^10.1.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-path-alias": "^2.1.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-header": "^1.2.2",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "libvesktop": "link:packages/libvesktop",
        "png-to-ico": "^3.0.1",
        "prettier": "^3.8.1",
        "puppeteer-core": "^24.42.0",
        "sharp": "^0.34.5",
        "source-map-support": "^0.5.21",
        "tsx": "^4.21.0",
        "type-fest": "^5.5.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.57.2",
        "winaudio": "link:packages/winaudio",
        "xml-formatter": "^3.6.7"
    },
    "packageManager": "pnpm@10.7.1",
    "engines": {
        "node": ">=18",
        "pnpm": ">=8"
    },
    "build": {
        "appId": "dev.diggy.discordmaxxer",
        "productName": "Discordmaxxer",
        "executableName": "discordmaxxer",
        "files": [
            "!*",
            "!node_modules",
            "dist/js",
            "static",
            "package.json",
            "LICENSE"
        ],
        "extraResources": [
            {
                "from": "vencord-dist",
                "to": "vencord-dist"
            },
            {
                "from": "build/shortcut-icon.ico",
                "to": "shortcut-icon.ico"
            },
            {
                "from": "packages/winaudio/prebuilds/winaudio-x64.node",
                "to": "winaudio.node"
            }
        ],
        "protocols": {
            "name": "Discord",
            "schemes": [
                "discord"
            ]
        },
        "beforePack": "scripts/build/beforePack.mjs",
        "afterPack": "scripts/build/afterPack.mjs",
        "linux": {
            "icon": "build/icon.png",
            "category": "Network",
            "maintainer": "lucidcobra@gmail.com",
            "target": [
                {
                    "target": "deb",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "rpm",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "desktop": {
                "entry": {
                    "Name": "Discordmaxxer",
                    "GenericName": "Internet Messenger",
                    "Type": "Application",
                    "Categories": "Network;InstantMessaging;Chat;",
                    "Keywords": "discord;discordmaxxer;vencord;electron;chat;",
                    "MimeType": "x-scheme-handler/discord",
                    "StartupWMClass": "discordmaxxer"
                }
            }
        },
        "mac": {
            "target": [
                {
                    "target": "default",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "category": "public.app-category.social-networking",
            "darkModeSupport": true,
            "extendInfo": {
                "NSMicrophoneUsageDescription": "This app needs access to the microphone",
                "NSCameraUsageDescription": "This app needs access to the camera",
                "com.apple.security.device.audio-input": true,
                "com.apple.security.device.camera": true,
                "CFBundleIconName": "Icon"
            },
            "notarize": true
        },
        "dmg": {
            "background": "build/background.tiff",
            "icon": "build/icon.icns",
            "iconSize": 105,
            "window": {
                "width": 512,
                "height": 340
            },
            "contents": [
                {
                    "x": 140,
                    "y": 160
                },
                {
                    "x": 372,
                    "y": 160,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "nsis": {
            "include": "build/installer.nsh",
            "oneClick": false,
            "artifactName": "Discordmaxxer-Setup-${version}.${ext}"
        },
        "win": {
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "publish": {
            "provider": "github",
            "owner": "dtman-gif",
            "repo": "discordmaxxer",
            "releaseType": "release"
        },
        "rpm": {
            "fpm": [
                "--rpm-rpmbuild-define=_build_id_links none"
            ]
        },
        "electronFuses": {
            "runAsNode": false,
            "enableCookieEncryption": false,
            "enableNodeOptionsEnvironmentVariable": false,
            "enableNodeCliInspectArguments": false,
            "enableEmbeddedAsarIntegrityValidation": false,
            "onlyLoadAppFromAsar": true,
            "loadBrowserProcessSpecificV8Snapshot": false,
            "grantFileProtocolExtraPrivileges": false
        }
    },
    "pnpm": {
        "patchedDependencies": {
            "arrpc@3.5.0": "patches/arrpc@3.5.0.patch",
            "electron-updater": "patches/electron-updater.patch"
        },
        "onlyBuiltDependencies": [
            "@vencord/venmic",
            "electron",
            "esbuild"
        ]
    }
}
